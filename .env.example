NEXT_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_development_key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MOMENTUS_LOCAL_DEMO_ENABLED=false
MOMENTUS_LOCAL_DEMO_EMAIL=momentus-demo@example.test
MOMENTUS_LOCAL_DEMO_PASSWORD=replace-with-a-local-random-password
MOMENTUS_LOCAL_DEMO_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Used only by Drizzle Kit when applying database migrations.
DATABASE_URL=

# Server-only. Leave blank until a specific admin operation needs it.
SUPABASE_SECRET_KEY=

# Optional server-side verification configuration.
SUPABASE_JWKS_URL=

# Optional AI design assistant. The API key is server-only; never use NEXT_PUBLIC_.
OPENAI_API_KEY=
MOMENTUS_AI_PROVIDER=openai
MOMENTUS_AI_MODEL=gpt-6.1-sol
MOMENTUS_AI_ENABLED=false
# Explicit deterministic assistant for local-only development; never a silent fallback.
MOMENTUS_AI_DEMO_MODE=false
